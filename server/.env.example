# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins (only needed when the client is not served via the Vite proxy)
CORS_ORIGINS=http://localhost:5180

# ---- Auth ----
# REQUIRED in production. Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Demo authentication (initial version, no credential store) ----
# Every ACTIVE employee in the workbook can sign in with this shared demo password.
# Never use demo authentication in production.
DEMO_AUTH_ENABLED=true
DEMO_PASSWORD=LeaveFlow@2026
# Show the demo password on the login screen
DEMO_SHOW_PASSWORD_HINT=true

# ---- Data provider ----
# excel (default). Future: postgres
DATA_PROVIDER=excel
WORKBOOK_PATH=./data/LeaveFlow.xlsx
BACKUP_DIR=./data/backups
UPLOAD_DIR=./uploads
